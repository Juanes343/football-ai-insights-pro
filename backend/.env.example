# ============================================================
#  BACKEND (Express + Socket.io) — Variables de entorno
#  Copia este archivo como .env para desarrollo local.
#  En Render configura estas variables en el panel.
# ============================================================

NODE_ENV=development
APP_NAME="Football AI Insights Pro"
PORT=4000

# --- Base de datos (Supabase / PostgreSQL) ---
# Conexión "pooled" (PgBouncer, puerto 6543) para la app:
DATABASE_URL="postgresql://postgres.xxxx:CONTRASENA@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) que Prisma usa para migraciones:
DIRECT_URL="postgresql://postgres.xxxx:CONTRASENA@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Redis (OPCIONAL). Déjalo vacío para funcionar sin caché ---
# Ej. Upstash: rediss://default:TOKEN@xxxx.upstash.io:6379
REDIS_URL=
REDIS_PASSWORD=

# --- JWT (mínimo 32 caracteres cada uno) ---
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_distinto
JWT_REFRESH_EXPIRES_IN=30d

# --- Frontend / CORS ---
# URL del frontend en Vercel. Para varios orígenes usa coma:
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- API de fútbol (RapidAPI / API-Football) ---
API_FOOTBALL_KEY=tu_api_football_key
API_FOOTBALL_BASE=https://v3.football.api-sports.io

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=token_interno_ai

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Email SMTP (opcional, para notificaciones) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Football AI Insights Pro <noreply@example.com>"

# --- Stripe (opcional, para suscripciones Premium) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
