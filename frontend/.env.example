# ============================================================
#  FRONTEND (Next.js) — Variables de entorno
#  Copia este archivo como .env.local para desarrollo.
#  En Vercel configura estas variables en el panel del proyecto.
# ============================================================

# URL del backend. IMPORTANTE: debe terminar en /api
# Local:      http://localhost:4000/api
# Producción: https://football-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# URL del WebSocket (mismo host del backend, SIN /api)
# Local:      http://localhost:4000
# Producción: https://football-backend.onrender.com
NEXT_PUBLIC_WS_URL=http://localhost:4000

NEXT_PUBLIC_APP_NAME="Football AI Insights Pro"

# --- NextAuth (solo si usas login con Google desde el frontend) ---
NEXTAUTH_SECRET=cambia_esto_por_un_secreto_aleatorio
NEXTAUTH_URL=http://localhost:3000
