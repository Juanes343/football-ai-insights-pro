# ============================================================
#  AI SERVICE (FastAPI + XGBoost) — Variables de entorno
#  Copia este archivo como .env para desarrollo local.
# ============================================================

# Base de datos (Supabase / PostgreSQL) — conexión directa
DATABASE_URL="postgresql://postgres.xxxx:CONTRASENA@aws-0-region.pooler.supabase.com:5432/postgres"

# Redis (opcional)
REDIS_URL=

# URL del backend (para CORS)
BACKEND_URL=http://localhost:4000

# Ruta donde se guarda/carga el modelo XGBoost
MODEL_PATH=models_saved/xgb_model.joblib

# Mínimo de partidos para poder reentrenar el modelo
MIN_MATCHES_FOR_TRAINING=20
