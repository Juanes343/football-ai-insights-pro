# URL del backend (la MISMA API del proyecto web).
# Desarrollo con celular físico → IP LAN de tu PC (NO localhost):
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
# Producción (Render):
#   EXPO_PUBLIC_API_URL=https://football-backend.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# RevenueCat (facturación in-app). Llaves PÚBLICAS de SDK (Project → API keys).
# Solo se usan en builds nativos (no en web/Expo Go).
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
